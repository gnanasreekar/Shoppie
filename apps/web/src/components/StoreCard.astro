---
import type { Store, Merchant } from '@shoppie/shared';

interface Props {
  store: Store;
  merchant?: Merchant;
}

const { store, merchant } = Astro.props;
const deliveryFee = merchant?.settings?.deliveryFee ?? 30;
const freeThreshold = merchant?.settings?.freeDeliveryThreshold ?? 499;
---

<div class="store-card group bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col">
  
  <!-- Banner Image -->
  <div class="relative h-32 w-full bg-slate-100 overflow-hidden">
    <img 
      src={store.bannerUrl || 'https://images.unsplash.com/photo-1604719312566-8912e9227c6a?auto=format&fit=crop&w=800&q=80'} 
      alt={store.name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>

    <!-- Open/Closed Tag -->
    <span class="absolute top-2.5 right-2.5 bg-emerald-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-xs flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
      Open Now
    </span>

    <!-- Store Logo overlay -->
    <div class="absolute -bottom-3 left-4 w-12 h-12 rounded-xl bg-white border-2 border-white shadow-md overflow-hidden">
      <img 
        src={store.logoUrl || 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=200&q=80'} 
        alt={store.name}
        class="w-full h-full object-cover"
      />
    </div>
  </div>

  <!-- Content -->
  <div class="p-4 pt-5 flex-1 flex flex-col">
    <div class="flex items-start justify-between gap-2 mb-1">
      <h3 class="font-bold text-slate-900 group-hover:text-brand-600 transition text-base leading-tight">
        <a href={`/stores/${store.slug}`}>{store.name}</a>
      </h3>
      <span class="bg-amber-50 text-amber-800 text-[11px] font-bold px-1.5 py-0.5 rounded flex items-center gap-0.5 shrink-0">
        ★ {merchant?.rating || '4.8'}
      </span>
    </div>

    <p class="text-xs text-slate-500 line-clamp-2 mb-3">
      {store.tagline || store.description}
    </p>

    <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-600">
      <div class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{store.city} ({store.pincode})</span>
      </div>
      <div class="font-semibold text-brand-600">
        Free del &gt; ₹{freeThreshold}
      </div>
    </div>

  </div>

</div>
