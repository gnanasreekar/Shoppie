---
import { DUMMY_CATEGORIES } from '@shoppie/shared';
---

<div class="w-full overflow-x-auto no-scrollbar py-2">
  <div class="flex items-center gap-3 min-w-max">
    <a 
      href="/" 
      class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-slate-900 text-white font-bold text-xs shadow-sm hover:bg-slate-800 transition"
    >
      <span>⚡ All Deals</span>
    </a>
    {DUMMY_CATEGORIES.map((cat) => (
      <a 
        href={`/?category=${cat.slug}`}
        class="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white border border-slate-200/80 hover:border-brand-500 hover:bg-orange-50/50 text-slate-700 font-medium text-xs shadow-xs transition group"
      >
        <span class="text-base group-hover:scale-110 transition-transform">{cat.icon}</span>
        <span class="group-hover:text-brand-600 transition-colors">{cat.name}</span>
      </a>
    ))}
  </div>
</div>
