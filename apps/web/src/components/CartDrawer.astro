---
---

<div id="cart-drawer-container" class="hidden fixed inset-0 z-50 overflow-hidden">
  <!-- Backdrop -->
  <div id="cart-backdrop" class="absolute inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity duration-300"></div>

  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col">
      
      <!-- Drawer Header -->
      <div class="p-4 sm:p-6 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <h2 class="text-base font-bold text-slate-900">Your Basket</h2>
        </div>
        <button id="close-cart-btn" class="p-2 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Merchant Banner & Free Delivery Meter -->
      <div id="cart-merchant-banner" class="bg-orange-50/70 px-4 py-3 border-b border-orange-100 text-xs">
        <div class="flex items-center justify-between text-slate-700 font-medium mb-1.5">
          <span>Ordering from: <strong id="cart-merchant-name" class="text-brand-700">Patel Kirana</strong></span>
          <button id="clear-cart-btn" class="text-slate-400 hover:text-rose-600 text-[11px] font-semibold underline">Clear</button>
        </div>
        <div class="w-full bg-orange-200/60 rounded-full h-1.5 overflow-hidden">
          <div id="free-delivery-progress" class="bg-brand-600 h-1.5 rounded-full transition-all duration-300" style="width: 60%"></div>
        </div>
        <div id="free-delivery-message" class="text-[11px] text-slate-500 mt-1 font-medium">
          Add ₹245 more for <span class="text-emerald-600 font-bold">FREE Delivery</span>
        </div>
      </div>

      <!-- Item List Container -->
      <div id="cart-items-list" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
        <!-- Rendered via Client TypeScript -->
      </div>

      <!-- Empty State -->
      <div id="cart-empty-state" class="hidden flex-1 flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-full bg-orange-100 flex items-center justify-center text-brand-600 mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 mb-1">Your cart is empty</h3>
        <p class="text-xs text-slate-500 max-w-xs mb-4">Explore our local stores in Varni & Nizamabad to add groceries, electronics, and produce.</p>
        <button id="browse-stores-btn" class="px-4 py-2 bg-brand-600 text-white text-xs font-bold rounded-xl hover:bg-brand-700 transition">
          Browse Local Stores
        </button>
      </div>

      <!-- Footer Checkout Summary -->
      <div id="cart-summary-footer" class="p-4 sm:p-6 bg-slate-50 border-t border-slate-200 space-y-3">
        <div class="space-y-1.5 text-xs text-slate-600">
          <div class="flex justify-between">
            <span>Item Subtotal</span>
            <span id="cart-subtotal" class="font-bold text-slate-900">₹0</span>
          </div>
          <div class="flex justify-between items-center">
            <span>Delivery Partner Fee</span>
            <span id="cart-delivery-fee" class="font-bold text-slate-900">₹30</span>
          </div>
          <div class="flex justify-between text-sm font-extrabold text-slate-900 pt-2 border-t border-slate-200">
            <span>Total to Pay</span>
            <span id="cart-total" class="text-brand-600">₹0</span>
          </div>
        </div>

        <a 
          href="/cart"
          id="proceed-checkout-btn"
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-bold shadow-md hover:shadow-lg transition active:scale-[0.99]"
        >
          <span>Proceed to Checkout</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</div>

<script>
  import { getCart, updateItemQuantity, clearCart, addToCart } from '../lib/cart';

  const drawerContainer = document.getElementById('cart-drawer-container');
  const cartBackdrop = document.getElementById('cart-backdrop');
  const closeBtn = document.getElementById('close-cart-btn');
  const cartTrigger = document.getElementById('cart-drawer-btn');
  const clearBtn = document.getElementById('clear-cart-btn');
  const browseBtn = document.getElementById('browse-stores-btn');

  const itemsList = document.getElementById('cart-items-list');
  const emptyState = document.getElementById('cart-empty-state');
  const summaryFooter = document.getElementById('cart-summary-footer');
  const merchantBanner = document.getElementById('cart-merchant-banner');
  const merchantNameEl = document.getElementById('cart-merchant-name');
  const freeProgress = document.getElementById('free-delivery-progress');
  const freeMsg = document.getElementById('free-delivery-message');
  const subtotalEl = document.getElementById('cart-subtotal');
  const deliveryEl = document.getElementById('cart-delivery-fee');
  const totalEl = document.getElementById('cart-total');

  function openDrawer() {
    drawerContainer?.classList.remove('hidden');
    renderCart();
  }

  function closeDrawer() {
    drawerContainer?.classList.add('hidden');
  }

  cartTrigger?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  cartBackdrop?.addEventListener('click', closeDrawer);
  browseBtn?.addEventListener('click', () => {
    closeDrawer();
    window.location.href = '/stores';
  });

  clearBtn?.addEventListener('click', () => {
    if (confirm('Are you sure you want to clear your cart?')) {
      clearCart();
      renderCart();
    }
  });

  function renderCart() {
    const cart = getCart();

    if (!cart.items || cart.items.length === 0) {
      itemsList?.classList.add('hidden');
      summaryFooter?.classList.add('hidden');
      merchantBanner?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      return;
    }

    emptyState?.classList.add('hidden');
    itemsList?.classList.remove('hidden');
    summaryFooter?.classList.remove('hidden');
    merchantBanner?.classList.remove('hidden');

    if (merchantNameEl) merchantNameEl.textContent = cart.merchantName || 'Local Store';

    // Free delivery progress calculation (default threshold ₹499)
    const threshold = 499;
    const progressPercent = Math.min(100, Math.round((cart.subtotal / threshold) * 100));
    if (freeProgress) freeProgress.style.width = `${progressPercent}%`;

    if (freeMsg) {
      if (cart.subtotal >= threshold) {
        freeMsg.innerHTML = '🎉 You have unlocked <span class="text-emerald-600 font-bold">FREE Local Delivery!</span>';
      } else {
        const remaining = threshold - cart.subtotal;
        freeMsg.innerHTML = `Add ₹${remaining} more for <span class="text-emerald-600 font-bold">FREE Delivery</span>`;
      }
    }

    if (subtotalEl) subtotalEl.textContent = `₹${cart.subtotal}`;
    if (deliveryEl) deliveryEl.textContent = cart.deliveryFee === 0 ? 'FREE' : `₹${cart.deliveryFee}`;
    if (totalEl) totalEl.textContent = `₹${cart.total}`;

    // Render item rows
    if (itemsList) {
      itemsList.innerHTML = cart.items
        .map(
          (item) => `
        <div class="flex items-center gap-3 py-3 border-b border-slate-100 last:border-0">
          <img 
            src="${item.productImage}" 
            alt="${item.productName}" 
            class="w-14 h-14 object-cover rounded-xl bg-slate-100 shrink-0"
          />
          <div class="flex-1 min-w-0">
            <h4 class="text-xs font-bold text-slate-900 truncate">${item.productName}</h4>
            <div class="text-[11px] text-slate-500">₹${item.unitPrice} each</div>
            <div class="text-xs font-bold text-brand-600 mt-0.5">₹${item.itemTotal}</div>
          </div>
          <div class="flex items-center gap-1.5 bg-slate-100 rounded-lg p-1">
            <button class="cart-qty-btn p-1 text-slate-500 hover:text-slate-900" data-id="${item.productId}" data-action="dec">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
            </button>
            <span class="text-xs font-bold text-slate-800 w-5 text-center">${item.quantity}</span>
            <button class="cart-qty-btn p-1 text-slate-500 hover:text-slate-900" data-id="${item.productId}" data-action="inc">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </button>
          </div>
        </div>
      `
        )
        .join('');

      // Attach qty listeners
      itemsList.querySelectorAll('.cart-qty-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const pid = target.getAttribute('data-id');
          const act = target.getAttribute('data-action');
          if (!pid) return;

          const itm = cart.items.find((i) => i.productId === pid);
          if (!itm) return;

          const newQty = act === 'inc' ? itm.quantity + 1 : itm.quantity - 1;
          updateItemQuantity(pid, newQty);
          renderCart();
        });
      });
    }
  }

  // Global delegate for "Add to Cart" buttons on any page
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.add-to-cart-btn');
    if (!target) return;

    const card = target.closest('.product-card');
    if (!card) return;

    const rawJson = card.getAttribute('data-product-json');
    if (!rawJson) return;

    try {
      const product = JSON.parse(rawJson);
      const res = addToCart(product, 1);
      if (!res.success) {
        alert(res.message);
      } else {
        openDrawer();
      }
    } catch (err) {
      console.error('Failed to parse product data:', err);
    }
  });

  window.addEventListener('shoppie-cart-updated', renderCart);
</script>
