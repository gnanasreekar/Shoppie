---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DUMMY_MERCHANTS, DUMMY_PRODUCTS, DUMMY_ORDERS } from '@shoppie/shared';

const merchant = DUMMY_MERCHANTS[0]; // Patel Kirana
const products = DUMMY_PRODUCTS.filter((p) => p.merchantId === merchant.id);
const orders = DUMMY_ORDERS;
---

<BaseLayout title="Merchant SaaS Portal | Shoppie Business Suite">
  <div class="space-y-8">
    
    <!-- Top Header & Store Status Bar -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-600 to-amber-500 flex items-center justify-center text-white font-black text-2xl shadow-md">
          P
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">{merchant.businessName}</h1>
            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">ACTIVE SHOP</span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Varni Main Bazaar • GSTIN: {merchant.gstin} • Plan: Starter Trial</p>
        </div>
      </div>

      <!-- Quick Toggles -->
      <div class="flex items-center gap-3 w-full md:w-auto">
        <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs text-slate-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="font-semibold">Taking Orders:</span>
          <span class="text-emerald-700 font-bold">ONLINE</span>
        </div>
        <a 
          href="/stores/patel-kirana-varni" 
          target="_blank"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition flex items-center gap-1.5"
        >
          <span>View Public Storefront</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>

    <!-- Analytics KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Today's Revenue</span>
        <div class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">₹4,280</div>
        <div class="text-[11px] text-emerald-600 font-semibold mt-1">↑ +18% vs yesterday</div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Active Orders</span>
        <div class="text-2xl sm:text-3xl font-black text-brand-600 mt-1">7</div>
        <div class="text-[11px] text-slate-500 font-medium mt-1">2 ready for pickup</div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Catalogue Items</span>
        <div class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">{products.length}</div>
        <div class="text-[11px] text-slate-500 font-medium mt-1">All verified & priced</div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">AI Queries Used</span>
        <div class="text-2xl sm:text-3xl font-black text-violet-600 mt-1">8 / 25</div>
        <div class="text-[11px] text-violet-600 font-medium mt-1">Starter plan quota</div>
      </div>
    </div>

    <!-- Main Tabbed Area -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden">
      <!-- Tabs Navigation -->
      <div class="flex border-b border-slate-200 px-6 pt-4 gap-6 text-xs font-bold overflow-x-auto no-scrollbar">
        <button id="tab-btn-orders" class="merchant-tab-btn pb-4 text-brand-600 border-b-2 border-brand-600 font-extrabold whitespace-nowrap">
          📦 Recent Orders ({orders.length})
        </button>
        <button id="tab-btn-inventory" class="merchant-tab-btn pb-4 text-slate-500 hover:text-slate-900 whitespace-nowrap">
          📋 Inventory & Pricing ({products.length})
        </button>
        <button id="tab-btn-ai" class="merchant-tab-btn pb-4 text-slate-500 hover:text-slate-900 flex items-center gap-1.5 whitespace-nowrap">
          <span>✨ AI Copilot Insights</span>
          <span class="bg-violet-100 text-violet-700 text-[10px] px-1.5 py-0.2 rounded font-bold">Smart</span>
        </button>
        <button id="tab-btn-settings" class="merchant-tab-btn pb-4 text-slate-500 hover:text-slate-900 whitespace-nowrap">
          ⚙️ Delivery & Store Rules
        </button>
      </div>

      <!-- Tab 1: Orders -->
      <div id="tab-content-orders" class="p-6">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-700">
            <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-4">Order ID</th>
                <th class="py-3 px-4">Customer</th>
                <th class="py-3 px-4">Items</th>
                <th class="py-3 px-4">Total</th>
                <th class="py-3 px-4">Payment</th>
                <th class="py-3 px-4">Status</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {orders.map((ord) => (
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-900">{ord.orderNumber}</td>
                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-900">{ord.customerName}</div>
                    <div class="text-[11px] text-slate-400">{ord.customerPhone}</div>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="truncate block max-w-xs">{ord.items.map((i) => `${i.quantity}x ${i.productName}`).join(', ')}</span>
                  </td>
                  <td class="py-3.5 px-4 font-bold text-slate-900">₹{ord.totalAmount}</td>
                  <td class="py-3.5 px-4">
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">
                      {ord.paymentMethod} ({ord.paymentStatus})
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class={`inline-block px-2.5 py-1 rounded-full text-[10px] font-extrabold ${ord.status === 'DELIVERED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
                      {ord.status}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <button class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg text-[11px]">
                      Manage
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tab 2: Inventory -->
      <div id="tab-content-inventory" class="hidden p-6 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <h3 class="font-bold text-slate-900 text-sm">Product Catalogue & Stock Tracking</h3>
          <button class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1">
            <span>+ Add Product</span>
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-700">
            <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-4">Item Name</th>
                <th class="py-3 px-4">SKU</th>
                <th class="py-3 px-4">Selling Price</th>
                <th class="py-3 px-4">MRP</th>
                <th class="py-3 px-4">Stock Qty</th>
                <th class="py-3 px-4 text-right">Stock Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {products.map((p) => (
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-3">
                      <img src={p.images[0]} class="w-10 h-10 object-cover rounded-lg bg-slate-100" />
                      <div>
                        <div class="font-bold text-slate-900">{p.name}</div>
                        <div class="text-[11px] text-slate-400">{p.unit}</div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-slate-500">{p.sku}</td>
                  <td class="py-3.5 px-4 font-bold text-slate-900">₹{p.salePrice ?? p.basePrice}</td>
                  <td class="py-3.5 px-4 text-slate-400">₹{p.basePrice}</td>
                  <td class="py-3.5 px-4 font-bold text-slate-800">{p.stockQuantity} units</td>
                  <td class="py-3.5 px-4 text-right">
                    <span class="inline-block px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                      IN STOCK
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Tab 3: AI Copilot -->
      <div id="tab-content-ai" class="hidden p-6 space-y-4">
        <div class="bg-violet-50 rounded-2xl p-5 border border-violet-100 space-y-2">
          <h4 class="text-sm font-bold text-violet-950 flex items-center gap-2">
            <span>✨ AI Merchant Assistant Recommendations</span>
          </h4>
          <p class="text-xs text-violet-800 leading-relaxed">
            Based on your last 7 days of sales in Varni, sunflower oil is selling 3x faster than normal. Consider stocking 20 more pouches before Friday to prevent stockouts.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl border border-slate-200 space-y-2">
            <span class="font-bold text-slate-900 block">📢 WhatsApp Promotional Broadcast Generator</span>
            <p class="text-slate-500 text-[11px]">Generate ready-to-send Telugu/English WhatsApp offers for your regular customer list.</p>
            <button class="px-3 py-1.5 bg-violet-600 text-white rounded-lg font-bold text-xs hover:bg-violet-700 transition">
              Draft Weekend WhatsApp Offer
            </button>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 space-y-2">
            <span class="font-bold text-slate-900 block">📊 Khata (Credit Ledger) Assistant</span>
            <p class="text-slate-500 text-[11px]">Track customer dues and draft polite automated WhatsApp payment reminders.</p>
            <button class="px-3 py-1.5 bg-slate-800 text-white rounded-lg font-bold text-xs hover:bg-slate-900 transition">
              Open Khata Ledger
            </button>
          </div>
        </div>
      </div>

      <!-- Tab 4: Store Settings -->
      <div id="tab-content-settings" class="hidden p-6 space-y-4 text-xs max-w-xl">
        <h3 class="font-bold text-slate-900 text-sm">Delivery & Storefront Parameters</h3>
        <p class="text-slate-500">Configure your local delivery terms. These update your public storefront immediately.</p>

        <div class="space-y-3 pt-2">
          <div>
            <label class="block font-medium text-slate-700 mb-1">Standard Delivery Fee (INR)</label>
            <input type="number" value={merchant.settings?.deliveryFee} class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 font-bold" />
          </div>

          <div>
            <label class="block font-medium text-slate-700 mb-1">Free Delivery Minimum Order Amount (INR)</label>
            <input type="number" value={merchant.settings?.freeDeliveryThreshold} class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 font-bold" />
          </div>

          <div class="pt-2">
            <label class="flex items-center gap-2">
              <input type="checkbox" checked={merchant.settings?.codEnabled} class="rounded text-brand-600 focus:ring-brand-500" />
              <span class="font-bold text-slate-900">Enable Cash on Delivery (COD) for Varni customers</span>
            </label>
          </div>

          <div class="pt-4">
            <button class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl transition">
              Save Settings
            </button>
          </div>
        </div>
      </div>

    </div>

  </div>
</BaseLayout>

<script>
  const tabOrders = document.getElementById('tab-btn-orders');
  const tabInventory = document.getElementById('tab-btn-inventory');
  const tabAI = document.getElementById('tab-btn-ai');
  const tabSettings = document.getElementById('tab-btn-settings');

  const contentOrders = document.getElementById('tab-content-orders');
  const contentInventory = document.getElementById('tab-content-inventory');
  const contentAI = document.getElementById('tab-content-ai');
  const contentSettings = document.getElementById('tab-content-settings');

  const tabs = [
    { btn: tabOrders, content: contentOrders },
    { btn: tabInventory, content: contentInventory },
    { btn: tabAI, content: contentAI },
    { btn: tabSettings, content: contentSettings },
  ];

  tabs.forEach(({ btn, content }) => {
    btn?.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.content?.classList.add('hidden');
        t.btn?.classList.remove('text-brand-600', 'border-b-2', 'border-brand-600', 'font-extrabold');
        t.btn?.classList.add('text-slate-500');
      });
      content?.classList.remove('hidden');
      btn.classList.add('text-brand-600', 'border-b-2', 'border-brand-600', 'font-extrabold');
      btn.classList.remove('text-slate-500');
    });
  });
</script>
