---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { DUMMY_STORES, DUMMY_MERCHANTS, DUMMY_PRODUCTS, type Store, type Merchant, type Product } from '@shoppie/shared';

export function getStaticPaths() {
  return DUMMY_STORES.map((store) => {
    const merchant = DUMMY_MERCHANTS.find((m) => m.id === store.merchantId);
    const storeProducts = DUMMY_PRODUCTS.filter((p) => p.merchantId === store.merchantId);
    return {
      params: { slug: store.slug },
      props: { store, merchant, products: storeProducts },
    };
  });
}

interface Props {
  store: Store;
  merchant?: Merchant;
  products: Product[];
}

const { store, merchant, products } = Astro.props;
const deliveryFee = merchant?.settings?.deliveryFee ?? 30;
const freeThreshold = merchant?.settings?.freeDeliveryThreshold ?? 499;
---

<BaseLayout title={`${store.name} | Shoppie Local Storefront`}>
  <div class="space-y-8">
    
    <!-- Storefront Header Banner -->
    <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
      <!-- Cover photo -->
      <div class="relative h-48 sm:h-64 w-full bg-slate-900 overflow-hidden">
        <img 
          src={store.bannerUrl} 
          alt={store.name} 
          class="w-full h-full object-cover opacity-85"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
        
        <span class="absolute top-4 right-4 bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          Open Today ({store.openingTime} - {store.closingTime})
        </span>
      </div>

      <!-- Store Details Strip -->
      <div class="p-6 sm:p-8 -mt-16 sm:-mt-20 relative z-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 pb-6 border-b border-slate-100">
          <div class="flex items-end gap-4">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-white border-4 border-white shadow-xl overflow-hidden shrink-0">
              <img 
                src={store.logoUrl} 
                alt={store.name} 
                class="w-full h-full object-cover"
              />
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">{store.name}</h1>
                <span class="bg-amber-100 text-amber-900 text-xs font-extrabold px-2 py-0.5 rounded-full flex items-center gap-1">
                  ★ {merchant?.rating || '4.8'}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">{store.tagline}</p>
              <div class="text-xs text-slate-400 flex items-center gap-1 mt-1">
                <span>📍 {store.addressLine1}, {store.city} ({store.pincode})</span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 w-full sm:w-auto">
            <a 
              href={`tel:${store.phone}`}
              class="flex-1 sm:flex-none px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Call Shop</span>
            </a>
            <button 
              onclick="navigator.clipboard.writeText(window.location.href); alert('Store link copied to clipboard!');"
              class="px-4 py-2 rounded-xl bg-orange-50 hover:bg-brand-100 text-brand-700 text-xs font-bold transition text-center"
            >
              Share Store
            </button>
          </div>
        </div>

        <!-- Store Policies Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 text-xs">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Delivery Fee</span>
            <span class="font-bold text-slate-800">₹{deliveryFee} (Free &gt; ₹{freeThreshold})</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Payment Methods</span>
            <span class="font-bold text-slate-800">{merchant?.settings?.codEnabled ? 'Cash on Delivery & UPI' : 'UPI & Cards'}</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Delivery Time</span>
            <span class="font-bold text-emerald-600">45 - 60 Minutes</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Pincodes Served</span>
            <span class="font-bold text-slate-800">{merchant?.settings?.pincodesServed.join(', ')}</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Store Products Catalogue -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">
          Store Catalogue ({products.length} Products)
        </h2>
        <span class="text-xs text-slate-500 font-medium">Genuine stock verified</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      {products.length === 0 && (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 text-slate-500 text-sm">
          No products currently listed for this store.
        </div>
      )}
    </div>

  </div>
</BaseLayout>
