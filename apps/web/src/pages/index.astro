---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryPills from '../components/CategoryPills.astro';
import StoreCard from '../components/StoreCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { DUMMY_STORES, DUMMY_MERCHANTS, DUMMY_PRODUCTS } from '@shoppie/shared';

// Filter parameter support if rendered
const selectedCategory = Astro.url.searchParams.get('category');
const filteredProducts = selectedCategory
  ? DUMMY_PRODUCTS.filter((p) => p.categoryId.includes(selectedCategory) || p.categoryName?.toLowerCase().includes(selectedCategory))
  : DUMMY_PRODUCTS;
---

<BaseLayout title="Shoppie - Local Multi-Vendor Commerce | Varni & Nizamabad">
  <div class="space-y-10 sm:space-y-14">
    
    <!-- Hero Banner with Local Vibe -->
    <section class="relative rounded-3xl bg-gradient-to-br from-brand-600 via-amber-600 to-orange-700 text-white p-6 sm:p-12 overflow-hidden shadow-xl">
      <!-- Background pattern -->
      <div class="absolute -right-12 -bottom-12 w-96 h-96 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
      <div class="absolute right-1/4 -top-12 w-64 h-64 rounded-full bg-amber-400/20 blur-xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-orange-100 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Hyperlocal Pilot live in Varni & Nizamabad</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
          Everything from your neighborhood stores, delivered fast.
        </h1>

        <p class="text-sm sm:text-base text-orange-100 font-normal leading-relaxed">
          Order authentic groceries from Patel Kirana, mobile accessories from Balaji Electronics, and fresh farm veggies straight from local Telangana growers.
        </p>

        <!-- Search input inside hero -->
        <div class="pt-2">
          <form action="/stores" method="GET" class="flex flex-col sm:flex-row gap-2 bg-white/95 backdrop-blur-md p-2 rounded-2xl shadow-xl max-w-xl">
            <div class="flex-1 flex items-center px-3">
              <svg class="w-5 h-5 text-slate-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input 
                type="text" 
                name="q"
                placeholder="What are you looking for today?" 
                class="w-full bg-transparent border-none text-slate-800 text-xs sm:text-sm placeholder-slate-400 focus:outline-none"
              />
            </div>
            <button 
              type="submit"
              class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm transition shadow-md shrink-0 text-center"
            >
              Search Local
            </button>
          </form>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-2 text-[11px] text-orange-100/90 font-medium">
          <span class="flex items-center gap-1">⚡ 60-min delivery</span>
          <span>•</span>
          <span class="flex items-center gap-1">💵 Cash on Delivery (COD)</span>
          <span>•</span>
          <span class="flex items-center gap-1">🤖 AI Smart Assistant</span>
        </div>
      </div>
    </section>

    <!-- AI Copilot Promo Strip -->
    <section class="bg-gradient-to-r from-violet-900 via-indigo-950 to-slate-900 rounded-2xl p-4 sm:p-5 text-white flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-violet-600 flex items-center justify-center font-bold text-lg text-white shadow-inner shrink-0">
          ✨
        </div>
        <div>
          <h3 class="text-sm font-bold text-violet-100">Need help finding local deals or managing your shop?</h3>
          <p class="text-xs text-violet-300">Shoppie AI Assistant is powered by OpenAI-compatible endpoints with custom budget limits.</p>
        </div>
      </div>
      <a 
        href="/ai-assistant"
        class="px-4 py-2 rounded-xl bg-white text-violet-950 font-bold text-xs hover:bg-violet-50 transition shadow-xs whitespace-nowrap shrink-0"
      >
        Open AI Copilot &rarr;
      </a>
    </section>

    <!-- Category Filter Pills -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">Explore by Category</h2>
        <span class="text-xs font-semibold text-slate-500">6 Local Categories</span>
      </div>
      <CategoryPills />
    </section>

    <!-- Featured Local Stores -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">Popular Stores Near You</h2>
          <p class="text-xs text-slate-500">Trusted merchants serving Varni (503201) & Nizamabad</p>
        </div>
        <a href="/stores" class="text-xs font-bold text-brand-600 hover:text-brand-700 transition">
          View all stores &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {DUMMY_STORES.map((store) => {
          const merchant = DUMMY_MERCHANTS.find((m) => m.id === store.merchantId);
          return <StoreCard store={store} merchant={merchant} />;
        })}
      </div>
    </section>

    <!-- Featured Products / Deals -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">Trending Local Deals</h2>
          <p class="text-xs text-slate-500">Daily staples, electronics, and freshly harvested greens</p>
        </div>
        {selectedCategory && (
          <a href="/" class="text-xs font-bold text-rose-600 hover:underline">
            ✕ Clear Category Filter
          </a>
        )}
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {filteredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </section>

    <!-- Merchant Onboarding Call to Action -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-xs flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100 text-brand-800 text-[11px] font-bold">
          🏬 For Telangana Retailers
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Are you a store owner in Varni or Nizamabad?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Launch your digital store in 5 minutes. Get WhatsApp order alerts, manage inventory on your phone, offer COD, and use our AI Copilot to boost customer retention.
        </p>
        <div class="flex items-center gap-4 pt-2 text-xs font-bold text-slate-700">
          <span>✓ 0% Launch Commission</span>
          <span>✓ Free Digital Storefront</span>
          <span>✓ Local Customer Reach</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
        <a 
          href="/pricing"
          class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm transition text-center shadow-md hover:shadow-lg"
        >
          View SaaS Plans
        </a>
        <a 
          href="/merchant"
          class="px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm transition text-center"
        >
          Explore Merchant Portal
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
