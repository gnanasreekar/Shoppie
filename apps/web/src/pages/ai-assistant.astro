---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AI_PROVIDER_PRESETS } from '@shoppie/shared';
---

<BaseLayout title="AI Assistant & Provider Settings | Shoppie">
  <div class="space-y-8">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-violet-100 text-violet-800 text-xs font-bold mb-2">
          <span>✨ OpenAI-Compatible Multi-Provider Engine</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">AI Assistant & Budget Controls</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Configure your own OpenAI-compatible endpoint (Groq, Ollama, DeepSeek, OpenAI) and set your custom monthly INR budget.</p>
      </div>

      <div class="flex items-center gap-2">
        <button id="toggle-config-drawer" class="px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition flex items-center gap-1.5 shadow-sm">
          <span>⚙️ Provider & Budget Config</span>
        </button>
      </div>
    </div>

    <!-- Provider Configuration & Budget Panel (Collapsible / Configurable) -->
    <div id="ai-settings-card" class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <div>
          <h2 class="text-base font-bold text-slate-900">LLM Provider & Budget Settings</h2>
          <p class="text-xs text-slate-500">All configurations are stored locally and fully editable at any time.</p>
        </div>
        <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">
          Live Config Active
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
        
        <!-- Left: Provider & Endpoint -->
        <div class="space-y-4">
          <h3 class="font-bold text-slate-900 text-sm">1. Choose or Customize LLM Provider</h3>

          <div>
            <label class="block font-medium text-slate-700 mb-1">Preset Provider Quick Select</label>
            <select id="preset-provider-select" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-800 font-semibold focus:ring-2 focus:ring-violet-500">
              {AI_PROVIDER_PRESETS.map((p) => (
                <option value={p.name} data-url={p.baseUrl} data-model={p.defaultModel}>
                  {p.name} ({p.defaultModel})
                </option>
              ))}
              <option value="Custom">Custom Endpoint...</option>
            </select>
          </div>

          <div>
            <label class="block font-medium text-slate-700 mb-1">Base URL (OpenAI-compatible format)</label>
            <input 
              type="text" 
              id="ai-base-url" 
              value="https://api.openai.com/v1"
              placeholder="e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1" 
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 font-mono text-xs focus:ring-2 focus:ring-violet-500"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-medium text-slate-700 mb-1">Model Name</label>
              <input 
                type="text" 
                id="ai-model-name" 
                value="gpt-4o-mini"
                placeholder="e.g. llama-3.3-70b-versatile" 
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 font-mono text-xs focus:ring-2 focus:ring-violet-500"
              />
            </div>
            <div>
              <label class="block font-medium text-slate-700 mb-1">API Key (Optional for local/test)</label>
              <input 
                type="password" 
                id="ai-api-key" 
                placeholder="sk-..." 
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 font-mono text-xs focus:ring-2 focus:ring-violet-500"
              />
            </div>
          </div>
        </div>

        <!-- Right: User Budget Selection & Meter -->
        <div class="space-y-4">
          <h3 class="font-bold text-slate-900 text-sm">2. Your Monthly AI Budget Limit</h3>

          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="font-medium text-slate-700">Choose Monthly Spending Limit (INR)</label>
              <span id="budget-display" class="font-black text-brand-600 text-sm">₹500 / month</span>
            </div>
            <input 
              type="range" 
              id="budget-slider" 
              min="100" 
              max="5000" 
              step="100" 
              value="500" 
              class="w-full accent-brand-600 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-slate-400 mt-1">
              <span>₹100 (Tester)</span>
              <span>₹500 (Moderate)</span>
              <span>₹2000 (Store Copilot)</span>
              <span>₹5000 (Heavy)</span>
            </div>
          </div>

          <!-- Live Budget Meter -->
          <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 space-y-2">
            <div class="flex justify-between text-xs">
              <span class="text-slate-500">Current Month Spend:</span>
              <strong id="usage-spent-label" class="text-slate-900">₹0.15</strong>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden">
              <div id="usage-meter-bar" class="bg-violet-600 h-2 rounded-full" style="width: 2%"></div>
            </div>
            <div class="flex justify-between text-[11px] text-slate-500">
              <span id="queries-count-label">3 queries made</span>
              <button id="reset-usage-btn" class="text-rose-600 hover:underline">Reset test stats</button>
            </div>
          </div>

          <button 
            id="save-ai-settings-btn"
            class="w-full py-2.5 px-4 bg-violet-600 hover:bg-violet-700 text-white font-bold rounded-xl text-xs transition shadow-sm"
          >
            Save Provider & Budget Preferences
          </button>
        </div>

      </div>
    </div>

    <!-- Live Interactive Chat Interface -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden flex flex-col h-[560px]">
      
      <!-- Chat Header -->
      <div class="p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="text-xs font-bold text-slate-900">Shoppie Assistant Terminal</span>
          <span class="text-xs text-slate-400">• Varni & Nizamabad Commerce Context</span>
        </div>
        <div class="flex gap-2">
          <button id="clear-full-chat-btn" class="text-xs text-slate-500 hover:text-rose-600 font-semibold px-2 py-1">
            Clear Conversation
          </button>
        </div>
      </div>

      <!-- Messages Stream -->
      <div id="full-chat-messages" class="flex-1 overflow-y-auto p-6 space-y-4 text-xs bg-slate-50/50">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full bg-violet-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
            AI
          </div>
          <div class="bg-white p-4 rounded-2xl rounded-tl-xs shadow-xs border border-slate-200 text-slate-700 max-w-xl leading-relaxed space-y-2">
            <p><strong>Namaste!</strong> I am your Shoppie Local Assistant.</p>
            <p>Try asking me:</p>
            <ul class="list-disc pl-4 space-y-1 text-slate-600">
              <li>"What are the best prices on Atta in Varni today?"</li>
              <li>"Compare boAt headphones in Nizamabad shops"</li>
              <li>"How can a local store owner set up free delivery thresholds?"</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Input Form -->
      <div class="p-4 bg-white border-t border-slate-200">
        <form id="full-chat-form" class="flex gap-3">
          <input 
            type="text" 
            id="full-chat-input"
            placeholder="Ask about local deals, store policies, or inventory guidance..." 
            class="flex-1 bg-slate-100 border-none rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-violet-500 transition"
          />
          <button 
            type="submit"
            class="px-6 py-3 bg-violet-600 hover:bg-violet-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-md flex items-center gap-2"
          >
            <span>Send</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </form>
      </div>

    </div>

  </div>
</BaseLayout>

<script>
  import {
    getAIProviderConfig,
    saveAIProviderConfig,
    getAIBudgetSettings,
    saveAIBudgetSettings,
    getAIUsageStats,
    sendAIChatMessage,
    type AIMessage,
  } from '../lib/ai-client';

  // Config elements
  const presetSelect = document.getElementById('preset-provider-select') as HTMLSelectElement;
  const baseUrlInput = document.getElementById('ai-base-url') as HTMLInputElement;
  const modelInput = document.getElementById('ai-model-name') as HTMLInputElement;
  const apiKeyInput = document.getElementById('ai-api-key') as HTMLInputElement;

  const budgetSlider = document.getElementById('budget-slider') as HTMLInputElement;
  const budgetDisplay = document.getElementById('budget-display');
  const spentLabel = document.getElementById('usage-spent-label');
  const meterBar = document.getElementById('usage-meter-bar');
  const queriesLabel = document.getElementById('queries-count-label');
  const resetBtn = document.getElementById('reset-usage-btn');
  const saveBtn = document.getElementById('save-ai-settings-btn');

  // Load existing values into inputs
  function loadSettings() {
    const config = getAIProviderConfig();
    const budget = getAIBudgetSettings();
    const usage = getAIUsageStats();

    if (baseUrlInput) baseUrlInput.value = config.baseUrl;
    if (modelInput) modelInput.value = config.model;
    if (apiKeyInput && config.apiKey) apiKeyInput.value = config.apiKey;

    if (budgetSlider) budgetSlider.value = budget.monthlyBudgetInr.toString();
    if (budgetDisplay) budgetDisplay.textContent = `₹${budget.monthlyBudgetInr} / month`;

    updateUsageUI(usage, budget.monthlyBudgetInr);
  }

  function updateUsageUI(usage: any, budgetLimit: number) {
    if (spentLabel) spentLabel.textContent = `₹${usage.totalCostInr.toFixed(2)}`;
    if (queriesLabel) queriesLabel.textContent = `${usage.totalQueries} queries made`;
    const percent = Math.min(100, Math.round((usage.totalCostInr / budgetLimit) * 100));
    if (meterBar) meterBar.style.width = `${Math.max(2, percent)}%`;
  }

  loadSettings();

  // Preset handler
  presetSelect?.addEventListener('change', () => {
    const selected = presetSelect.options[presetSelect.selectedIndex];
    const url = selected.getAttribute('data-url');
    const model = selected.getAttribute('data-model');
    if (url && baseUrlInput) baseUrlInput.value = url;
    if (model && modelInput) modelInput.value = model;
  });

  // Slider handler
  budgetSlider?.addEventListener('input', () => {
    if (budgetDisplay) budgetDisplay.textContent = `₹${budgetSlider.value} / month`;
  });

  // Save settings
  saveBtn?.addEventListener('click', () => {
    const config = getAIProviderConfig();
    config.baseUrl = baseUrlInput.value;
    config.model = modelInput.value;
    config.apiKey = apiKeyInput.value;
    saveAIProviderConfig(config);

    const budget = getAIBudgetSettings();
    budget.monthlyBudgetInr = Number(budgetSlider.value);
    saveAIBudgetSettings(budget);

    alert('✅ AI Provider & Budget settings saved successfully!');
    loadSettings();
  });

  resetBtn?.addEventListener('click', () => {
    localStorage.removeItem('shoppie_ai_usage_stats');
    loadSettings();
  });

  // Chat stream
  const chatMessages = document.getElementById('full-chat-messages');
  const chatForm = document.getElementById('full-chat-form');
  const chatInput = document.getElementById('full-chat-input') as HTMLInputElement;
  const clearChatBtn = document.getElementById('clear-full-chat-btn');

  let history: AIMessage[] = [];

  clearChatBtn?.addEventListener('click', () => {
    history = [];
    if (chatMessages) {
      chatMessages.innerHTML = `
        <div class="text-center py-8 text-slate-400 text-xs italic">
          Conversation cleared. Type a new message below.
        </div>
      `;
    }
  });

  chatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!chatInput || !chatInput.value.trim()) return;

    const userText = chatInput.value.trim();
    chatInput.value = '';

    const userMsg: AIMessage = {
      id: `usr_${Date.now()}`,
      role: 'user',
      content: userText,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    };
    history.push(userMsg);
    appendMsg(userMsg);

    // AI response
    try {
      const aiReply = await sendAIChatMessage(history, 'customer');
      history.push(aiReply);
      appendMsg(aiReply);
      loadSettings(); // refresh usage meter
    } catch {
      appendMsg({
        id: `err_${Date.now()}`,
        role: 'assistant',
        content: 'Error processing your request. Please check your provider URL or API Key.',
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      });
    }
  });

  function appendMsg(msg: AIMessage) {
    if (!chatMessages) return;
    const isUser = msg.role === 'user';
    const div = document.createElement('div');
    div.className = `flex items-start gap-3 ${isUser ? 'flex-row-reverse' : ''}`;

    div.innerHTML = `
      <div class="w-8 h-8 rounded-full ${isUser ? 'bg-slate-900' : 'bg-violet-600'} text-white flex items-center justify-center font-bold text-xs shrink-0">
        ${isUser ? 'YOU' : 'AI'}
      </div>
      <div class="${isUser ? 'bg-slate-900 text-white' : 'bg-white text-slate-700 border border-slate-200'} p-4 rounded-2xl ${isUser ? 'rounded-tr-xs' : 'rounded-tl-xs'} shadow-xs max-w-xl leading-relaxed text-xs">
        <p>${msg.content.replace(/\n/g, '<br/>')}</p>
        <span class="block text-[9px] ${isUser ? 'text-slate-400' : 'text-slate-400'} mt-1 text-right">${msg.timestamp}</span>
      </div>
    `;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
</script>
