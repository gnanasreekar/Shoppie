# ============================================
# SHOPPIE - Environment Configuration
# Copy to .env and fill in your values
# All values are configurable defaults
# ============================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoppie?schema=public"

# ---- Supabase Auth ----
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- JWT (fallback if not using Supabase) ----
JWT_SECRET="change-this-to-a-random-64-char-string"
JWT_EXPIRY="7d"

# ---- AI Provider (OpenAI-compatible endpoint) ----
# Switch providers by changing these 3 vars
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="sk-your-api-key"
AI_MODEL="gpt-4o-mini"
AI_PREMIUM_MODEL="gpt-4o"
AI_MAX_TOKENS="4096"
AI_MONTHLY_BUDGET_CAP="10000"

# ---- Payment Gateway (Razorpay) ----
RAZORPAY_KEY_ID="rzp_test_your_key"
RAZORPAY_KEY_SECRET="your_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ---- SMS / OTP Provider ----
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID="SHOPIE"

# ---- Email ----
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="noreply@shoppie.in"

# ---- App Config ----
NODE_ENV="development"
API_PORT="3001"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# ---- Feature Flags (override DB defaults) ----
FEATURE_AI_ASSISTANT="false"
FEATURE_MULTI_MERCHANT_CART="false"
FEATURE_B2B="false"
FEATURE_WHATSAPP="false"
FEATURE_COMMISSION="false"
